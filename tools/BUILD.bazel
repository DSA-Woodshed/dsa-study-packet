load("@packet_pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_test")
load(":test_lanes.bzl", "UNIT_TESTS")

exports_files(["requirements.lock.txt"])

_DATA = [
    "//:python_sources",
    "//:validation_inputs",
    "//:test_inventory",
    "check.py",
    "pytest_main.py",
    "run_integration.py",
    "test_lanes.bzl",
    "validation_snapshot.py",
]

_CONCEPTS = [
    requirement("flask"),
    requirement("hypothesis"),
    requirement("numpy"),
    requirement("pydantic"),
    requirement("scipy"),
]

# These tests need only declared Python sources, data, and PyPI wheels.
# Editor/git/tool-installation integration tests remain in the local uv lane.
py_test(
    name = "unit_tests",
    size = "medium",
    srcs = [
        "pytest_main.py",
        "run_integration.py",
        "validation_snapshot.py",
    ],
    args = UNIT_TESTS,
    data = _DATA,
    env = {"PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1"},
    legacy_create_init = False,
    main = "pytest_main.py",
    python_version = "3.14.3",
    deps = [
        "//:packet",
        requirement("pytest"),
        requirement("pytest_benchmark"),
    ] + _CONCEPTS,
)

py_test(
    name = "lint",
    size = "small",
    srcs = [
        "check.py",
        "validation_snapshot.py",
    ],
    args = [
        "ruff",
        "$(rootpath @packet_pypi//ruff:data)",
    ],
    data = _DATA + ["@packet_pypi//ruff:data"],
    legacy_create_init = False,
    main = "check.py",
    python_version = "3.14.3",
    deps = [requirement("ruff")],
)

py_test(
    name = "typecheck",
    size = "medium",
    srcs = [
        "check.py",
        "validation_snapshot.py",
    ],
    args = ["mypy"],
    data = _DATA,
    legacy_create_init = False,
    main = "check.py",
    python_version = "3.14.3",
    deps = [
        "//:packet",
        requirement("mypy"),
        requirement("pytest"),
        requirement("scipy_stubs"),
        requirement("pytest_benchmark"),
    ] + _CONCEPTS,
)

test_suite(
    name = "check",
    tests = [
        ":lint",
        ":typecheck",
        ":unit_tests",
    ],
    visibility = ["//visibility:public"],
)
