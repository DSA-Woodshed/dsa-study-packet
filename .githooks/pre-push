#!/usr/bin/env bash
# DSA Woodshed pre-push hook.
# Refuses: a push to DSA-Woodshed authority or its transferred aliases, unsigned commits and AI
# attribution in the pushed range. Warns: branch name without a semantic prefix.
# The pushed range is every commit not already on a remote-tracking ref.
set -u

# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"

remote_name="${1:-}"
remote_url="${2:-}"

# Transfers preserve the original personal URLs as redirects to org authority.
# Match those exact product names; the actual -contrib forks remain writable.
# The port alternative covers GitHub SSH URLs with an explicit port.
woodshed_is_authority_remote() {
  printf '%s\n' "$1" | grep -iqE 'github\.com([:/]+|:[0-9]+/)(DSA-Woodshed/|Jesssullivan/(dsa-study-packet|dsa-woodshed\.space)(\.git)?/?$)'
}

# True for the all-zero object name git uses for a missing ref, in either
# object format (40 hex digits for SHA-1, 64 for SHA-256).
woodshed_is_null_oid() {
  case "$1" in
    "" | *[!0]*) return 1 ;;
  esac
  return 0
}

# The argument that makes `git rebase` start at the given commit.
woodshed_rebase_base() {
  if git rev-parse -q --verify "$1~1" >/dev/null; then
    git rev-parse --short "$1~1"
  else
    printf -- '--root\n'
  fi
}

input="$(mktemp "${TMPDIR:-/tmp}/woodshed-pre-push.XXXXXX")"
trap 'rm -f "$input"' EXIT
cat > "$input"

if woodshed_is_authority_remote "$remote_url"; then
  woodshed_refuse "push to organization authority '$remote_name' ($remote_url), including transferred redirects; work lands only through a pull request from your fork" \
    "Fork first" \
    "git remote -v   # point origin at your actual personal fork, then git push origin HEAD and open its pull request"
  exit 1
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  if woodshed_is_null_oid "$local_sha"; then continue; fi

  case "$remote_ref" in
    refs/heads/*)
      branch="${remote_ref#refs/heads/}"
      if ! printf '%s\n' "$branch" | grep -qE '^(feat|fix|hotfix|docs|chore|ci)/[a-z0-9][a-z0-9.-]*$'; then
        woodshed_warn "branch '$branch' has no semantic prefix (feat/ fix/ hotfix/ docs/ chore/ ci/) and kebab-case slug" \
          "Branches" \
          "git branch -m '${local_ref#refs/heads/}' feat/short-slug && git push origin feat/short-slug"
      fi
      ;;
  esac

  exclude=(--not --remotes)
  if ! woodshed_is_null_oid "$remote_sha" && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    exclude+=("$remote_sha")
  fi

  unsigned=""
  oldest_unsigned=""
  for sha in $(git rev-list "$local_sha" "${exclude[@]}"); do
    raw="$(git cat-file commit "$sha")"
    header="$(printf '%s\n' "$raw" | sed '/^$/q')"
    message="$(printf '%s\n' "$raw" | sed '1,/^$/d')"
    short="$(git rev-parse --short "$sha")"

    if ! printf '%s\n' "$header" | grep -qE '^gpgsig(-sha256)? '; then
      parents="$(printf '%s\n' "$header" | grep -c '^parent ')"
      if [ "$parents" -gt 1 ] && printf '%s\n' "$header" | grep -qE '^committer GitHub <noreply@github\.com> '; then
        : # merge commits made by GitHub are exempt
      else
        unsigned="$short${unsigned:+ $unsigned}"
        oldest_unsigned="$sha"
      fi
    fi

    if line="$(printf '%s\n' "$message" | woodshed_ai_attribution_line)"; then
      woodshed_refuse "commit $short carries AI attribution: $line" \
        "Commits" \
        "git rebase -i $(woodshed_rebase_base "$sha")   # mark $short as reword, delete that line, then git push origin HEAD --force-with-lease"
    fi
  done

  if [ -n "$oldest_unsigned" ]; then
    woodshed_refuse "unsigned commits in the pushed range: $unsigned" \
      "Commits" \
      "git config commit.gpgsign true && git rebase --force-rebase --gpg-sign $(woodshed_rebase_base "$oldest_unsigned") && git push origin HEAD --force-with-lease"
  fi
done < "$input"

if [ "$WOODSHED_REFUSED" -ne 0 ]; then
  exit 1
fi

woodshed_chain pre-push "$input" "$remote_name" "$remote_url"
