load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_tectonic//tectonic:defs.bzl", "tectonic_pdf")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "booklet_inputs",
    srcs = glob(["src/algo/**/*.py"]) + ["reference-sheets/appendix-topics.json"],
)

py_binary(
    name = "gen_booklet",
    srcs = ["scripts/gen_booklet.py"],
    legacy_create_init = False,
    main = "scripts/gen_booklet.py",
    python_version = "3.14.3",
)

# Generated sources belong to the graph; a git archive contains every input.
# Explicit root locations also work when this is an external Bazel module.
genrule(
    name = "booklet_tex",
    srcs = [
        ":booklet_inputs",
        "src/algo/__init__.py",
        "reference-sheets/appendix-topics.json",
    ],
    outs = ["booklet.tex"],
    cmd = "$(location :gen_booklet) --algo-src $$(dirname $(location src/algo/__init__.py)) --appendix-data $(location reference-sheets/appendix-topics.json) --output $@",
    tools = [":gen_booklet"],
)

tectonic_pdf(
    name = "booklet",
    src = "booklet.tex",
    bundle = ":tex_bundle",
    extra_args = [
        "-Z",
        "deterministic-mode",
    ],
    reruns = 2,
    tags = ["no-remote-exec"],
)

py_binary(
    name = "gen_tex_bundle",
    srcs = ["build_support/gen_tex_bundle.py"],
    legacy_create_init = False,
    main = "build_support/gen_tex_bundle.py",
    python_version = "3.14.3",
)

genrule(
    name = "tex_bundle",
    srcs = [
        "@packet_tex//:files",
        "@packet_tex//:resources/SSOT",
        "build_support/tex-resources.lock.json",
    ],
    outs = ["packet-tex-bundle.zip"],
    cmd = "$(location :gen_tex_bundle) --lock $(location build_support/tex-resources.lock.json) --input-dir $$(dirname $(location @packet_tex//:resources/SSOT)) --output $@",
    tools = [":gen_tex_bundle"],
)

sh_test(
    name = "booklet_smoke",
    size = "small",
    srcs = ["tests/booklet_pdf_smoke.sh"],
    args = ["$(rootpath :booklet)"],
    data = [":booklet"],
    tags = ["no-remote-exec"],
)

py_library(
    name = "packet",
    srcs = glob(["src/**/*.py"]),
    imports = ["src"],
)

filegroup(
    name = "python_sources",
    srcs = glob([
        "src/**/*.py",
        "scripts/**/*.py",
        "tests/**/*.py",
        "build_support/**/*.py",
    ]),
)

filegroup(
    name = "validation_inputs",
    srcs = glob([
        "docs/**/*.md",
        "reference-sheets/**/*.md",
        "reference-sheets/**/*.json",
    ]) + [
        "README.md",
        "pyproject.toml",
    ],
)
